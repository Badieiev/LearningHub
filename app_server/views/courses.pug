extends layout

include _includes/rating.pug

block content
  h1= pageHeader.title
  p= pageHeader.strapline

  .row
    .col-xs-12
      input.form-control(
        type='text'
        placeholder='Search courses'
      )

  br

  .row
    each course in courses
      .col-xs-12.col-sm-6.col-md-3
        .panel.panel-default
          .panel-body
            h3
              a(href='/course/' + course._id)= course.name
            p
              +outputRating(course.rating)
            p= course.description

  app-course-list

block scripts
  link(rel='stylesheet', href='/build/styles-5INURTSO.css')
  script(type='module', src='/build/main-R7ECCKPY.js')
  