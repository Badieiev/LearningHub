extends layout

block content
  .container
    h1 Register

    form
      .form-group
        label(for='name') Name
        input.form-control(type='text', id='name')

      .form-group
        label(for='email') Email
        input.form-control(type='email', id='email')

      .form-group
        label(for='password') Password
        input.form-control(type='password', id='password')

      .form-group
        label(for='confirmPassword') Confirm Password
        input.form-control(type='password', id='confirmPassword')

      button.btn.btn-primary(type='submit') Register