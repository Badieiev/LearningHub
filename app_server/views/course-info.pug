extends layout

include _includes/rating.pug

block content
  .row
    .col-xs-12
      h1= course.name

  .row
    .col-xs-12.col-md-8
      .panel.panel-default
        .panel-body
          h3 Course Information
          p
            +outputRating(course.rating)
          p= course.description

          h3 What you will learn
          each topic in course.topics
            p= topic

          a.btn.btn-primary(href='#') Enroll

    .col-xs-12.col-md-4
      .panel.panel-default
        .panel-body
          h3 About this course
          p= course.about