extends layout

block content
  .container
    h1= pageHeader.title
    if error
      .alert.alert-danger(role='alert')
        = error

    form(action='/login', method='POST')
      .form-group
        label(for='email')= form.emailLabel
        input.form-control(
          type='email',
          id='email',
          name='email',
          required
        )

      .form-group
        label(for='password')= form.passwordLabel
        input.form-control(
          type='password',
          id='password',
          name='password',
          required
        )

      button.btn.btn-primary(type='submit')= form.buttonText
